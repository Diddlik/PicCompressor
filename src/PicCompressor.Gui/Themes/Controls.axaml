<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- Eigenes ButtonSpinner-Aussehen (Basis von NumericUpDown): runde FieldBrush-Fläche,
         Ink-Rahmen, Ink-Chevrons, ohne Trennlinien. ClipToBounds rundet die inneren Ecken —
         das Standard-Theme ließ ein eckiges Rechteck in der runden Umrandung stehen und setzt
         die Trennlinien-BorderThickness per Converter (lokaler Wert, per Style nicht abschaltbar).
         Implizit über x:Type gesetzt; ButtonSpinner wird hier nur in NumericUpDown genutzt. -->
    <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <DataValidationErrors>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    ClipToBounds="True">
              <DockPanel>
                <StackPanel Name="PART_SpinnerPanel" DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            IsVisible="{TemplateBinding ShowButtonSpinner}">
                  <RepeatButton Name="PART_IncreaseButton" Width="32" Padding="0"
                                Focusable="False"
                                Background="Transparent" BorderThickness="0"
                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                    <Path Data="M1,6 L7,1 L13,6" Stroke="{DynamicResource InkBrush}"
                          StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </RepeatButton>
                  <RepeatButton Name="PART_DecreaseButton" Width="32" Padding="0"
                                Focusable="False"
                                Background="Transparent" BorderThickness="0"
                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                    <Path Data="M1,1 L7,6 L13,1" Stroke="{DynamicResource InkBrush}"
                          StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </RepeatButton>
                </StackPanel>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Stretch" />
              </DockPanel>
            </Border>
          </DataValidationErrors>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ RepeatButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource NeutralPillBrush}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PcText}" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PcText}" />
  </Style>

  <Style Selector="TextBlock.sub">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource PcDim}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource PcFaint}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource PcMono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource PcDim}" />
  </Style>

  <Style Selector="TextBlock.caps">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PcFaint}" />
  </Style>

  <!-- Karte: Panel-Fläche mit Rahmen, wie die Vorlagen-Panels. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource PcPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource PcCardRadius}" />
    <Setter Property="Padding" Value="16,15" />
  </Style>

  <Style Selector="Border.row">
    <Setter Property="Background" Value="{DynamicResource PcPanel2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PcBorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="10,9" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PcAccent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource PcControlRadius}" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PcAccentStrong}" />
    <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource PcPanel2}" />
    <Setter Property="Foreground" Value="{DynamicResource PcText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource PcControlRadius}" />
    <Setter Property="Padding" Value="13,8" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource PcAccent}" />
    <Setter Property="Background" Value="{DynamicResource PcPanel2}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PcText}" />
  </Style>

  <!-- Kompakte Textaktion für Zeilenbefehle (MP-002); dezent bis zum Zeigerkontakt. -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PcAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PcAccentSoft}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PcAccentStrong}" />
  </Style>
  <Style Selector="Button.link:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- Navigationsschiene (Prototype): 52px-Zeile, Icon-Chip wird bei Auswahl lime, Zeile ink. -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="0" />
    <!-- Volle Railbreite, damit die Ink-Auswahl bei allen Einträgen gleich groß ist. -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="root" Background="Transparent" CornerRadius="16" Padding="12,0" MinHeight="52">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#root">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#root">
    <Setter Property="Background" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked">
    <Setter Property="Foreground" Value="{DynamicResource InkTextInverse}" />
  </Style>
  <!-- Icon-Chip in der Zeile. -->
  <Style Selector="Border.navchip">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Segment-Umschalter (Engine, Chroma). -->
  <Style Selector="RadioButton.segment">
    <Setter Property="Foreground" Value="{DynamicResource PcDim}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="root" Background="Transparent" CornerRadius="7" Padding="10,7">
          <ContentPresenter Content="{TemplateBinding Content}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#root">
    <Setter Property="Background" Value="{DynamicResource PcAccent}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Border.segmentHost">
    <Setter Property="Background" Value="{DynamicResource PcPanel2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PcBorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="3" />
  </Style>

  <Style Selector="RadioButton.option">
    <Setter Property="Foreground" Value="{DynamicResource PcText}" />
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="11,8" />
    <!-- Auswahl im Bento-Look: Lime-Markierung statt dunklem Default-Rechteck (u. a. beim
         Erst-Klick in NumericUpDown, wo der Wert markiert wird). Caret in Ink. -->
    <Setter Property="SelectionBrush" Value="{DynamicResource LimeBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
  </Style>
  <!-- Fokus/Hover: Feldfläche + Ink-Schrift beibehalten. Fluent würde sonst auf dunkle
       Theme-Brushes (TextControlBackgroundFocused) wechseln → schwarzes Feld mit schwarzer Schrift. -->
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="TextBox:focus, TextBox:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <!-- Zahleneingabe (MinSaving, Timeouts …) im Bento-Look. -->
  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PcMonoFont}" />
  </Style>
  <!-- Inneres Textfeld nicht selbst rahmen — sonst überlagert es den Ink-Rahmen des Spinners
       (Rahmen wirkte abgeschnitten, nur bei Hover korrekt). -->
  <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <!-- NumericUpDown markiert den Wert bei jeder Änderung → sonst bleibt ein eckiges
         Auswahlrechteck im Feld stehen. In Zahlenfeldern die Markierung unsichtbar halten. -->
    <Setter Property="SelectionBrush" Value="Transparent" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- Pfeil-Glyphen erben die Foreground des ButtonSpinners; Default ist hell → auf Feldfläche unsichtbar. -->
  <Style Selector="NumericUpDown /template/ ButtonSpinner">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <!-- Spinner-Tasten transparent: ihre deckende Default-Fläche überdeckte sonst die runde
       rechte Ecke des Ink-Rahmens (rechte Seite wirkte abgeschnitten). -->
  <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource NeutralPillBrush}" />
  </Style>

  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="9,3" />
  </Style>

  <!-- ============================================================= -->
  <!-- Redesign "Cozy-neon bento" — gemeinsame Steuerelemente (S2).    -->
  <!-- docs/UI - refinement/01-design-system.md. Neue Klassen; die     -->
  <!-- alten Pc*-Stile oben bleiben, bis alle Views migriert sind.     -->
  <!-- ============================================================= -->

  <!-- Standardschrift der App (S0/S1). -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource PcUiFont}" />
  </Style>

  <!-- Typografie -->
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontFamily" Value="{DynamicResource PcDisplayFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="TextBlock.heroTitle">
    <Setter Property="FontFamily" Value="{DynamicResource PcDisplayFont}" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontFamily" Value="{DynamicResource PcDisplayFont}" />
    <Setter Property="FontSize" Value="18.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="TextBlock.bodyText">
    <Setter Property="FontFamily" Value="{DynamicResource PcUiFont}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontFamily" Value="{DynamicResource PcUiFont}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.captionText">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource MutedText2Brush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.capsLabel">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource MutedText2Brush}" />
  </Style>
  <Style Selector="TextBlock.monoNum">
    <Setter Property="FontFamily" Value="{DynamicResource PcMonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="TextBlock.bigStat">
    <Setter Property="FontFamily" Value="{DynamicResource PcMonoFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <!-- Flächen -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="Padding" Value="21" />
    <Setter Property="BoxShadow" Value="5 6 0 0 #E617140E" />
  </Style>
  <Style Selector="Border.tile">
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource TileRadius}" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="BoxShadow" Value="4 5 0 0 #E617140E" />
  </Style>
  <!-- Eingezogene Zeile (Queue-/Info-Zeilen). -->
  <Style Selector="Border.insetRow">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <!-- Primärbutton .cta — eigenes Template, weil nur ein Border BoxShadow zeichnet. -->
  <Style Selector="Button.cta">
    <Setter Property="Background" Value="{DynamicResource LimeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderThickness" Value="2.5" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="FontFamily" Value="{DynamicResource PcUiFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="shell" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="3 3 0 0 #FF17140E">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.cta:pointerover /template/ Border#shell">
    <Setter Property="BoxShadow" Value="4 4 0 0 #FF17140E" />
  </Style>
  <Style Selector="Button.cta:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-1px)" />
  </Style>
  <Style Selector="Button.cta:disabled /template/ Border#shell">
    <Setter Property="Background" Value="#EDE7DA" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector="Button.cta:disabled /template/ ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="#B0A892" />
  </Style>

  <!-- Sekundärbutton .ghost (+ Varianten) -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="15,9" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Button.ghost.violet:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VioletSoftBrush}" />
  </Style>
  <Style Selector="Button.ghost.coral:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CoralSoftBrush}" />
  </Style>
  <Style Selector="Button.ghost.lime:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LimeBrush}" />
  </Style>
  <Style Selector="Button.ghost:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Segment-Umschalter (Ink-Auswahl auf Canvas-Pille). -->
  <Style Selector="Border.segmentHost">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="5" />
  </Style>
  <Style Selector="RadioButton.segment">
    <Setter Property="Foreground" Value="{DynamicResource MutedText2Brush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="root" Background="Transparent" CornerRadius="999" Padding="12,7">
          <ContentPresenter Content="{TemplateBinding Content}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#root">
    <Setter Property="Background" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Foreground" Value="{DynamicResource InkTextInverse}" />
  </Style>

  <!-- Auswahlkarte (gestyltes RadioButton) mit Ring + Titel/Beschreibung. -->
  <Style Selector="RadioButton.optioncard">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="root" Background="{DynamicResource PaperBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="2"
                CornerRadius="16" Padding="14,12">
          <Grid ColumnDefinitions="22,14,*" VerticalAlignment="Center">
            <Border Name="ring" Grid.Column="0" Width="22" Height="22" CornerRadius="999"
                    BorderBrush="#C9C1B0" BorderThickness="2" Background="Transparent"
                    VerticalAlignment="Center">
              <Ellipse Name="dot" Width="10" Height="10" Fill="{DynamicResource LimeBrush}"
                       IsVisible="False" />
            </Border>
            <ContentPresenter Grid.Column="2"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              VerticalAlignment="Center" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.optioncard:pointerover /template/ Border#root">
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="RadioButton.optioncard:checked /template/ Border#root">
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="Background" Value="#29B9EE43" />
  </Style>
  <Style Selector="RadioButton.optioncard:checked /template/ Border#ring">
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="RadioButton.optioncard:checked /template/ Ellipse#dot">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- Kippschalter: eigenes ToggleButton-Template (48×28). -->
  <Style Selector="ToggleButton.switch">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="track" Width="48" Height="28" CornerRadius="999"
                Background="#EDE7DA" BorderBrush="{DynamicResource InkBrush}" BorderThickness="2">
          <Ellipse Name="knob" Width="20" Height="20" Fill="#FFFFFF"
                   Stroke="{DynamicResource InkBrush}" StrokeThickness="2"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
            <Ellipse.RenderTransform>
              <TranslateTransform X="0" />
            </Ellipse.RenderTransform>
          </Ellipse>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.switch:checked /template/ Border#track">
    <Setter Property="Background" Value="{DynamicResource LimeBrush}" />
  </Style>
  <Style Selector="ToggleButton.switch:checked /template/ Ellipse#knob">
    <Setter Property="RenderTransform" Value="translateX(20px)" />
  </Style>

  <!-- Slider: Ink-Akzent. -->
  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Slider /template/ Track /template/ RepeatButton#PART_DecreaseButton /template/ Border">
    <Setter Property="Background" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Slider /template/ Thumb /template/ Border">
    <Setter Property="Background" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
  </Style>

  <!-- Eingaben -->
  <Style Selector="TextBox.field">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="11,8" />
  </Style>
  <Style Selector="TextBox.field.mono">
    <Setter Property="FontFamily" Value="{DynamicResource PcMonoFont}" />
  </Style>

  <!-- Pillen/Badges (mono, Ink-Rahmen) -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Background" Value="{DynamicResource NeutralPillBrush}" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource PcMonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Border.badge.lime">
    <Setter Property="Background" Value="{DynamicResource LimeBrush}" />
  </Style>
  <Style Selector="Border.badge.violet">
    <Setter Property="Background" Value="{DynamicResource VioletSoftBrush}" />
  </Style>
  <Style Selector="Border.badge.mint">
    <Setter Property="Background" Value="{DynamicResource MintTileBrush}" />
  </Style>

  <!-- Bildlaufleiste: schlanke Overlay-Leiste im Bento-Look (Ink-Griff auf transparenter Spur).
       Teilenamen aus dem Avalonia-Fluent-Theme: Container VerticalRoot/HorizontalRoot,
       Spur ist ein Rectangle#TrackRect, Pfeiltasten PART_LineUp/DownButton. Deren dunkle
       Default-Fläche (ScrollBarBackground) erzeugte sonst das schwarze Rechteck. -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="10" />
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="10" />
  </Style>
  <Style Selector="ScrollBar /template/ Border#VerticalRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar /template/ Border#HorizontalRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- Pfeil-/Zeilentasten ganz weg. -->
  <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ScrollBar /template/ RepeatButton#PART_LineDownButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- Seiten-Repeatbuttons transparent, Klickfläche bleibt erhalten. -->
  <Style Selector="ScrollBar /template/ RepeatButton#PART_PageUpButton">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar /template/ RepeatButton#PART_PageDownButton">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Griff im Ink-Look. -->
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource InkBrush}" />
  </Style>

</Styles>
